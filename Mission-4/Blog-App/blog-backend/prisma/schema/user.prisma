model User {
    id String @id @default(uuid())
    name String @db.VarChar(255)
    email String @unique
    password String
    //ACTIVE coming from ActiveStaus
    activeStaus ActiveStaus  @default(ACTIVE)
    //authomatic will be import user form enum
    role Role @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    //Profliel? Stands for one to one relation with Profile model 
    profileId Profile? 
    //table name rename use @@
    @@map("users")
}



