model User {
    id String @id @default(uuid())
    name String @db.VarChar(255)
    email String @unique
    password String
    //ACTIVE coming from ActiveStaus
    activeStaus ActiveStaus  @default(ACTIVE)
    //authomatic will be import user form enum
    role Role @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    //1 to 1 relation like ekta user ekta profile korte parbe 
    profile Profile? 
    //1 to many relation ekta user onek gola comment korte parbe
    comments Comment[]

    //1 to many 
    posts Post[]
    //table name rename use @@
    @@map("users")
}



