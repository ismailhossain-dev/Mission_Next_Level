model User {
    id String @id @default(uuid())
    name String @db.VarChar(255)
    email String @unique
    password String
    activeStatus ActiveStatus @default(ACTIVE)
    role Role @default(USER)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    //1 to many
    profile Profile?
    @@map("users")
}
